Options -Indexes
<FilesMatch "(?i)(?:\.(?:csv|zip|sql|md|log|bak|env|py|cjs)$|^migrate\.php$|^\.)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:\.git|hisabtrackerpro-main|tests|api|supabase)(?:/|$) - [F,L]
</IfModule>
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://hmqckyecenigcjikfjob.supabase.co wss://hmqckyecenigcjikfjob.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self'; frame-ancestors 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
